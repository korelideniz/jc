      html+="<div class='yr-ban fl' style='animation-delay:"+nd().toFixed(2)+"s;animation-play-state:paused;'>"
        +"<div class='yr-num "+yc+"'>"+yr+"</div>"
        +"<div class='yr-sub'><div class='yr-label'>"+(y?"second year":"first year")+"</div><div class='yr-desc'>"+(y?"강의 확장 시즌":"강의 개시 시즌")+"</div></div>"
        +"<div class='yr-line "+yc+"'></div></div>";
    }
    html+="<div class='month-sec' id='ms-"+m+"' data-ms='"+m+"'>";
    var mc=i27(m)?"y27":"y26";
    html+="<div class='month-head "+mc+" fl' style='animation-delay:"+nd().toFixed(2)+"s;animation-play-state:paused;'>"
      +"<span class='month-num'>"+gn(m)+"</span><span class='month-ko'>월</span>"
      +"<span class='month-count'>강의 "+(uc.length+lc.length)+"개</span></div>";
    if(uc.length){
      html+="<div class='clbl u'><div class='clbl-dot'></div>필수 과정 <span class='clbl-count'>"+uc.length+"강</span></div>";
      html+="<div class='card-grid' style='margin-bottom:16px;'>";
      uc.forEach(function(c){html+=cardHTML(c,"u");});html+="</div>";
    }
    if(lc.length){
      html+="<div class='clbl l'><div class='clbl-dot'></div>평생 과정 <span class='clbl-count'>"+lc.length+"강</span></div>";
      html+="<div class='card-grid'>";
      lc.forEach(function(c){html+=cardHTML(c,"l");});html+="</div>";
    }
    html+="</div><div class='divider'></div>";
  });
  html+="<div class='yr-ban fl' style='animation-delay:"+nd().toFixed(2)+"s;animation-play-state:paused;'><div class='yr-num y28'>2028</div><div class='yr-line y28'></div></div>"
    +"<div class='cs-wrap fu' style='animation-delay:"+nd().toFixed(2)+"s;animation-play-state:paused;'><div class='cs-title'>2028년 이후 강의</div><div class='cs-sub'>이후 공개 예정입니다.</div><div class='cs-badge'>📅 추후 공개 예정</div></div>"
    +"<div class='divider'></div>";
  out.innerHTML=html;
  if("IntersectionObserver" in window){
    var obs=new IntersectionObserver(function(entries){entries.forEach(function(e){if(e.isIntersecting){e.target.style.animationPlayState="running";obs.unobserve(e.target);}});},{threshold:0.02,rootMargin:"0px 0px -20px 0px"});
