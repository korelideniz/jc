function gn(m){return m.split("-")[1].replace(/^0/,"");}
function gy(m){return m.split("-")[0];}
function i27(m){return gy(m)==="2027";}
function bm(a,m){return a.filter(function(c){return c.m===m;});}

function countUp(el,target,dur){
  var s=0,step=target/(dur/16);
  var t=setInterval(function(){s+=step;if(s>=target){s=target;clearInterval(t);}el.textContent=Math.floor(s).toLocaleString();},16);
}
var dly=0.25;
function nd(){var d=dly;dly+=0.022;return d;}

function cardHTML(c,tp){
  var fin=c.fin,on=c.on;
  var base=fin?"c-fin":(tp==="u"?(on?"cu-on":"cu-off"):(on?"cl-on":"cl-off"));
  var hasLink=!!c.url;
  var cls="card fu "+base+(hasLink?" lnk":"");
  var oc=hasLink?" onclick=\"window.open('"+c.url+"','_blank')\"":"";
  var ar=hasLink?"<span class='c-arr'>&#8599;</span> ":"";
  var d=nd();
  var dateCls=(on||fin)?"c-date don":"c-date doff";
  var dateTxt=(on||fin)?("📅 "+c.d):("🔔 "+c.d+" 공개예정");
  var statusHTML=fin?"<div class='c-status'>★ 시리즈 완결</div>":(on?"<div class='c-status'>✓ 공개 완료</div>":"");
  return "<div class='"+cls+"'"+oc+" style='animation-delay:"+d.toFixed(2)+"s;animation-play-state:paused;'>"
    +"<div class='"+dateCls+"'>"+dateTxt+"</div>"
    +"<div class='c-body'><div class='c-title'>"+ar+c.t+"</div><div class='c-sub'>"+c.s+"</div>"+statusHTML+"</div></div>";
}

function render(){
