function buildNav(){
  var nav=document.getElementById("jcu-nav");if(!nav)return;
  var active=MONTHS.filter(function(m){return bm(U,m).length||bm(L,m).length;});
  var html="<div class='nav-inner' id='jcu-ni'>",prevYr="";
  active.forEach(function(m){
    var yr=gy(m),y=i27(m);
    if(yr!==prevYr){if(prevYr)html+="<div class='nav-div'></div>";html+="<div class='nav-yr "+(y?"y27":"y26")+"'>"+yr+"</div>";prevYr=yr;}
    html+="<button class='nav-btn' data-m='"+m+"' onclick='jcuGo(\""+m+"\")'><span class='nav-num'>"+gn(m)+"</span><span class='nav-ko'>월</span></button>";
  });
  html+="</div>";
  var hint=nav.querySelector(".nav-hint");nav.innerHTML="";if(hint)nav.appendChild(hint);
  var tmp=document.createElement("div");tmp.innerHTML=html;nav.appendChild(tmp.firstChild);
  if(active.length)setAct(active[0]);
}

function setAct(m){
  document.querySelectorAll("#jcu-nav .nav-btn").forEach(function(b){
    b.classList.remove("on26","on27");
    if(b.getAttribute("data-m")===m){b.classList.add(i27(m)?"on27":"on26");var ni=document.getElementById("jcu-ni");if(ni)ni.scrollTo({left:b.offsetLeft-ni.offsetWidth/2+b.offsetWidth/2,behavior:"smooth"});}
  });
}

window.jcuGo=function(m){
  var el=document.getElementById("ms-"+m);if(!el)return;
  var nav=document.getElementById("jcu-nav");
  window.scrollTo({top:el.getBoundingClientRect().top+window.pageYOffset-(nav?nav.offsetHeight:70)-10,behavior:"smooth"});
  setAct(m);
};

(function(){var tick=false;
  window.addEventListener("scroll",function(){if(tick)return;tick=true;
    requestAnimationFrame(function(){
      var nav=document.getElementById("jcu-nav"),navH=nav?nav.offsetHeight:70,cur=null;
      document.querySelectorAll("[data-ms]").forEach(function(s){if(s.getBoundingClientRect().top<=navH+80)cur=s.getAttribute("data-ms");});
      if(cur)setAct(cur);tick=false;
    });
  });
})();

function initCounter(){
  var eu=document.getElementById("jcu-cu"),el=document.getElementById("jcu-cl");
  var stat=document.querySelector("#jcu-roadmap .hd-stats");
  function start(){if(eu)countUp(eu,1316,1800);if(el)countUp(el,2564,1800);}
  if("IntersectionObserver" in window&&stat){var o=new IntersectionObserver(function(e){if(e[0].isIntersecting){start();o.disconnect();}},{threshold:0.3});o.observe(stat);}else{start();}
}

