<!-- 정철대학 커리큘럼 로드맵 | STEP 단계형 | 워드프레스 완전호환 -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css" rel="stylesheet">

<style id="jcrms-css">
/* ── 워드프레스 여백 제거 ── */
.elementor-widget-html .elementor-widget-container,
.elementor-widget-html .elementor-column-wrap,
.elementor-widget-html .elementor-column,
.elementor-widget-html .elementor-row,
.elementor-widget-html .e-con-inner {
  padding-left:0!important; padding-right:0!important; max-width:100%!important;
}
#jcrms-outer {
  width:100vw; position:relative; left:50%; margin-left:-50vw;
  overflow-x:hidden; box-sizing:border-box;
}

/* ════════════════════════════════════
   디자인 방향: 모던 에디토리얼
   배경: 크림 오프화이트 #FAF8F4
   전공: 딥 네이비 #1A2744
   평생: 버건디 #7D2E3E
   완결: 골드 #C8941A
   라인: 연한 세피아 #D4C9B8
════════════════════════════════════ */

#jcrms {
  font-family:'Pretendard','Apple SD Gothic Neo','Noto Sans KR',sans-serif;
  background:#FAF8F4;
  color:#1A1A1A;
  box-sizing:border-box; width:100%;
  -webkit-font-smoothing:antialiased;
}
#jcrms * { box-sizing:inherit; }

/* ── 애니메이션 ── */
@keyframes jcs-up   { from{opacity:0;transform:translateY(20px);} to{opacity:1;transform:translateY(0);} }
@keyframes jcs-in   { from{opacity:0;} to{opacity:1;} }
@keyframes jcs-line { from{width:0;} to{width:100%;} }
@keyframes jcs-blink{ 0%,100%{opacity:1;} 50%{opacity:0.35;} }

/* ════ 헤더 ════ */
#jcrms .hd {
  background:#1A2744;
  padding:160px 60px 150px;
  display:flex; flex-direction:column; align-items:center;
  text-align:center; gap:24px; position:relative; overflow:hidden;
  animation:jcs-in .6s ease both;
}
#jcrms .hd::before {
  content:'';
  position:absolute; bottom:-1px; left:0; right:0; height:60px;
  background:#FAF8F4;
  clip-path:ellipse(55% 100% at 50% 100%);
}
/* 격자 배경 */
#jcrms .hd::after {
  content:'';
  position:absolute; inset:0; pointer-events:none;
  background-image:
    linear-gradient(rgba(255,255,255,.04) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.04) 1px, transparent 1px);
  background-size:48px 48px;
}
#jcrms .hd-inner { position:relative; z-index:2; }
#jcrms .hd-tag {
  display:inline-block;
  background:#C8941A; color:#fff;
  font-size:13px; font-weight:800; letter-spacing:4px;
  padding:8px 20px; border-radius:30px; text-transform:uppercase;
  animation:jcs-up .5s ease .1s both;
}
#jcrms .hd-title {
  font-family:'Pretendard',sans-serif;
  font-size:68px; font-weight:900; line-height:1.2; margin:0;
  color:#FFFFFF; letter-spacing:-2px;
  animation:jcs-up .55s ease .15s both;
}
#jcrms .hd-title span { color:#C8941A; }
#jcrms .hd-sub {
  font-size:24px; color:rgba(255,255,255,.6); font-weight:500; margin:0;
  animation:jcs-up .5s ease .2s both;
}
#jcrms .hd-desc {
  font-size:20px; color:rgba(255,255,255,.45); font-weight:400;
  max-width:560px; line-height:1.7; margin:0;
  animation:jcs-up .5s ease .25s both;
}
#jcrms .hd-badges {
  display:flex; gap:14px; justify-content:center; flex-wrap:wrap;
  animation:jcs-up .5s ease .3s both;
}
#jcrms .hd-badge {
  display:flex; align-items:center; gap:8px;
  padding:12px 24px; border-radius:8px; font-size:19px; font-weight:700;
  border:1.5px solid;
}
#jcrms .hd-badge-u { background:rgba(255,255,255,.08); border-color:rgba(255,255,255,.2); color:#fff; }
#jcrms .hd-badge-l { background:rgba(200,148,26,.12); border-color:rgba(200,148,26,.35); color:#C8941A; }
#jcrms .hd-badge-dot { width:8px; height:8px; border-radius:50%; flex-shrink:0; }

/* ════ STEP 진행 바 (PC sticky) ════ */
#jcrms .step-nav {
  position:sticky; top:0; z-index:999;
  background:#fff;
  border-bottom:2px solid #E8E2D8;
  padding:0 60px;
  display:flex; align-items:center; gap:0;
  box-shadow:0 2px 20px rgba(0,0,0,.06);
  animation:jcs-in .4s ease .5s both;
  overflow-x:auto;
  scrollbar-width:none;
}
#jcrms .step-nav::-webkit-scrollbar { display:none; }
#jcrms .snav-btn {
  display:flex; flex-direction:column; align-items:center;
  padding:14px 24px; background:none; border:none; cursor:pointer;
  font-family:'Pretendard',sans-serif;
  gap:4px; flex-shrink:0; position:relative;
  transition:color .15s;
  color:#888;
}
#jcrms .snav-btn::after {
  content:''; position:absolute; bottom:0; left:8%; right:8%;
  height:3px; border-radius:3px 3px 0 0;
  background:#1A2744; transform:scaleX(0); transition:transform .2s;
}
#jcrms .snav-btn:hover { color:#1A2744; }
#jcrms .snav-btn:hover::after { transform:scaleX(1); }
#jcrms .snav-btn.active { color:#1A2744; }
#jcrms .snav-btn.active::after { transform:scaleX(1); }
#jcrms .snav-num {
  font-size:13px; font-weight:900; letter-spacing:2px; text-transform:uppercase;
}
#jcrms .snav-label { font-size:19px; font-weight:800; white-space:nowrap; }
#jcrms .snav-divider { width:1px; height:28px; background:#E8E2D8; flex-shrink:0; margin:0 4px; }

/* ════ STEP 섹션 ════ */
#jcrms .step-section { padding:0 0 80px; }

/* STEP 헤더 */
#jcrms .step-hd {
  display:flex; align-items:stretch;
  margin-bottom:0; position:relative;
}
/* 왼쪽 큰 번호 */
#jcrms .step-num-col {
  width:220px; flex-shrink:0;
  background:#1A2744;
  display:flex; flex-direction:column;
  align-items:center; justify-content:center;
  padding:48px 24px; gap:8px;
  position:relative;
}
#jcrms .step-num-col::after {
  content:'';
  position:absolute; right:-24px; top:0; bottom:0;
  width:24px;
  background:#1A2744;
  clip-path:polygon(0 0, 0 100%, 100% 50%);
}
#jcrms .step-step {
  font-size:12px; font-weight:900; letter-spacing:4px;
  color:rgba(255,255,255,.5); text-transform:uppercase;
}
#jcrms .step-n {
  font-family:'Pretendard',sans-serif;
  font-size:80px; font-weight:900; color:#fff;
  line-height:1; letter-spacing:-4px;
}
#jcrms .step-period { display:none; }
/* 오른쪽 설명 */
#jcrms .step-info-col {
  flex:1; background:#1e2f54;
  padding:40px 48px 40px 56px;
  display:flex; flex-direction:column; justify-content:center; gap:12px;
}
#jcrms .step-target-tag {
  font-size:12px; font-weight:800; letter-spacing:3px;
  color:#C8941A; text-transform:uppercase;
}
#jcrms .step-title {
  font-family:'Pretendard',sans-serif;
  font-size:36px; font-weight:900; color:#fff; margin:0; line-height:1.3;
}
#jcrms .step-target {
  font-size:22px; color:rgba(255,255,255,.72); font-weight:500; line-height:1.7;
  padding:16px 20px;
  background:rgba(255,255,255,.07);
  border-left:3px solid #C8941A;
  border-radius:0 6px 6px 0;
}
#jcrms .step-target em {
  font-style:normal; color:#FFD166; font-weight:700;
}

/* ════ 콘텐츠 그리드 ════ */
#jcrms .step-body {
  padding:36px 60px 0;
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:0;
}
#jcrms .track {
  padding:0 24px 0 0;
  border-right:2px solid #E8E2D8;
}
#jcrms .track:last-child { padding:0 0 0 24px; border-right:none; }
#jcrms .track-label {
  display:flex; align-items:center; gap:10px;
  margin-bottom:20px; padding-bottom:12px;
  border-bottom:2px solid;
}
#jcrms .track-label.u { border-color:#1A2744; }
#jcrms .track-label.l { border-color:#7D2E3E; }
#jcrms .track-dot { width:10px; height:10px; border-radius:2px; flex-shrink:0; }
#jcrms .track-label.u .track-dot { background:#1A2744; }
#jcrms .track-label.l .track-dot { background:#7D2E3E; }
#jcrms .track-name {
  font-size:22px; font-weight:900; letter-spacing:1px;
}
#jcrms .track-label.u .track-name { color:#1A2744; }
#jcrms .track-label.l .track-name { color:#7D2E3E; }

/* ── 과목 행 (선 + 점 스타일) ── */
#jcrms .course-list { display:flex; flex-direction:column; gap:0; position:relative; }
#jcrms .course-list::before {
  content:'';
  position:absolute; left:11px; top:12px; bottom:12px; width:2px;
  background:#E8E2D8;
}
#jcrms .course-item {
  display:flex; align-items:flex-start; gap:16px;
  padding:14px 14px 14px 0;
  border-bottom:1px solid #F0EAE0;
  cursor:default;
  transition:background .15s;
  position:relative; z-index:1;
  border-radius:6px;
}
#jcrms .course-item:last-child { border-bottom:none; }
#jcrms .course-item:hover { background:#F5F1EB; }
#jcrms .course-item.lnk { cursor:pointer; }

#jcrms .course-dot {
  width:24px; height:24px; border-radius:50%; flex-shrink:0;
  display:flex; align-items:center; justify-content:center;
  margin-top:2px; font-size:12px; font-weight:900;
  border:2px solid;
}
#jcrms .track-u .course-dot.on  { background:#1A2744; border-color:#1A2744; color:#fff; }
#jcrms .track-u .course-dot.off { background:#FAF8F4; border-color:#C4B9A8; color:#C4B9A8; animation:jcs-blink 2.4s ease-in-out infinite; }
#jcrms .track-l .course-dot.on  { background:#7D2E3E; border-color:#7D2E3E; color:#fff; }
#jcrms .track-l .course-dot.off { background:#FAF8F4; border-color:#C4B9A8; color:#C4B9A8; animation:jcs-blink 2.4s ease-in-out infinite; }
#jcrms .course-dot.fin { background:#C8941A; border-color:#C8941A; color:#fff; }

#jcrms .course-info { flex:1; }
#jcrms .course-date {
  font-size:13px; font-weight:800; letter-spacing:1px;
  margin-bottom:3px;
}
#jcrms .track-u .course-date.on  { color:#1A2744; }
#jcrms .track-u .course-date.off { color:#B0A898; }
#jcrms .track-l .course-date.on  { color:#7D2E3E; }
#jcrms .track-l .course-date.off { color:#B0A898; }
#jcrms .course-name {
  font-size:24px; font-weight:900; line-height:1.3; margin-bottom:4px;
}
#jcrms .track-u .course-name.on  { color:#1A2744; }
#jcrms .track-u .course-name.off { color:#B8AFA4; }
#jcrms .track-l .course-name.on  { color:#7D2E3E; }
#jcrms .track-l .course-name.off { color:#B8AFA4; }
#jcrms .course-name.fin { color:#C8941A; }
#jcrms .course-sub {
  font-size:18px; font-weight:500; line-height:1.6;
}
#jcrms .track-u .course-sub.on  { color:#4A5878; }
#jcrms .track-u .course-sub.off { color:#C8BFB4; }
#jcrms .track-l .course-sub.on  { color:#7D4A52; }
#jcrms .track-l .course-sub.off { color:#C8BFB4; }
#jcrms .course-sub.fin { color:#A87818; }

#jcrms .course-status {
  display:inline-flex; align-items:center; gap:5px;
  padding:6px 16px; border-radius:20px;
  font-size:16px; font-weight:800; margin-top:8px;
}
#jcrms .track-u .course-status.on  { background:#EBF0FA; color:#1A2744; }
#jcrms .track-u .course-status.off { background:#F5F2EE; color:#B0A898; border:1px dashed #D4C9B8; }
#jcrms .track-l .course-status.on  { background:#F9EEF0; color:#7D2E3E; }
#jcrms .track-l .course-status.off { background:#F5F2EE; color:#B0A898; border:1px dashed #D4C9B8; }
#jcrms .course-status.fin { background:#FDF3DC; color:#C8941A; }

/* ── STEP 구분선 ── */
#jcrms .step-divider {
  height:3px; margin:40px 60px 0;
  background:linear-gradient(90deg,#1A2744,#7D2E3E,#C8941A,transparent);
  opacity:.25; border-radius:3px;
}

/* ── 연결 화살표 ── */
#jcrms .step-arrow {
  display:flex; align-items:center; justify-content:center;
  padding:20px 0;
  color:#C8941A; font-size:28px;
}

/* 푸터 */
#jcrms .foot {
  background:#1A2744;
  text-align:center; padding:32px 20px;
  font-size:15px; color:rgba(255,255,255,.35); font-weight:600;
}
#jcrms .foot-note {
  margin-top:8px;
  font-size:13px; color:rgba(255,255,255,.25);
}

/* 카드 등장 */
#jcrms .fu { opacity:0; animation:jcs-up .25s ease forwards; }

/* ════ 한눈에 보기 섹션 ════ */
#jcrms .overview {
  background:#fff;
  padding:72px 60px 80px;
  border-bottom:2px solid #E8E2D8;
}
#jcrms .ov-header {
  text-align:center; margin-bottom:52px;
}
#jcrms .ov-tag {
  display:inline-block;
  font-size:12px; font-weight:800; letter-spacing:4px;
  color:#C8941A; text-transform:uppercase;
  margin-bottom:14px;
}
#jcrms .ov-title {
  font-size:44px; font-weight:900; color:#1A2744;
  line-height:1.25; letter-spacing:-1px; margin:0 0 16px;
}
#jcrms .ov-sub {
  font-size:20px; color:#888; font-weight:500;
}

/* 5개 카드 가로 배치 */
#jcrms .ov-grid {
  display:grid;
  grid-template-columns:repeat(5,1fr);
  gap:0;
  position:relative;
}
/* 카드 사이 연결 화살표 선 */
#jcrms .ov-grid::before {
  content:'';
  position:absolute;
  top:54px; left:10%; right:10%; height:3px;
  background:linear-gradient(90deg,#1A2744,#7D2E3E,#C8941A);
  opacity:.18; border-radius:2px; z-index:0;
}

#jcrms .ov-card {
  display:flex; flex-direction:column; align-items:center;
  text-align:center; padding:0 12px;
  position:relative; z-index:1; cursor:pointer;
  transition:transform .2s;
}
#jcrms .ov-card:hover { transform:translateY(-6px); }
#jcrms .ov-card:hover .ov-num-circle { box-shadow:0 8px 28px rgba(26,39,68,.25); }

#jcrms .ov-num-circle {
  width:64px; height:64px; border-radius:50%;
  display:flex; align-items:center; justify-content:center;
  font-size:22px; font-weight:900; color:#fff;
  margin-bottom:16px; flex-shrink:0;
  box-shadow:0 4px 16px rgba(26,39,68,.18);
  transition:box-shadow .2s;
}
#jcrms .ov-card:nth-child(1) .ov-num-circle { background:linear-gradient(135deg,#1A2744,#2d4570); }
#jcrms .ov-card:nth-child(2) .ov-num-circle { background:linear-gradient(135deg,#234060,#3a6090); }
#jcrms .ov-card:nth-child(3) .ov-num-circle { background:linear-gradient(135deg,#5a3060,#7D2E3E); }
#jcrms .ov-card:nth-child(4) .ov-num-circle { background:linear-gradient(135deg,#7D2E3E,#a04858); }
#jcrms .ov-card:nth-child(5) .ov-num-circle { background:linear-gradient(135deg,#C8941A,#e0aa30); }

#jcrms .ov-step-lbl {
  font-size:14px; font-weight:900; letter-spacing:2px;
  color:#B0A898; text-transform:uppercase; margin-bottom:8px;
}
#jcrms .ov-card-title {
  font-size:22px; font-weight:900; color:#1A2744;
  margin-bottom:10px; line-height:1.3;
}
#jcrms .ov-period { display:none; }
#jcrms .ov-target {
  font-size:17px; color:#444; font-weight:600;
  line-height:1.65; word-break:keep-all;
}
#jcrms .ov-tags {
  display:flex; flex-wrap:wrap; gap:6px; justify-content:center;
  margin-top:12px;
}
#jcrms .ov-tag-item {
  font-size:15px; font-weight:700; padding:6px 13px;
  border-radius:4px; white-space:nowrap;
}
#jcrms .ov-tag-u {
  background:#EBF0FA; color:#1A2744;
}
#jcrms .ov-tag-l {
  background:#F9EEF0; color:#7D2E3E;
}

/* 구분선 (overview → content) */
#jcrms .ov-divider {
  height:4px;
  background:linear-gradient(90deg,#1A2744 0%,#7D2E3E 50%,#C8941A 100%);
  opacity:.12;
}

/* 모바일 */
@media(max-width:767px){
  #jcrms .overview { padding:48px 16px 56px; }
  #jcrms .ov-title { font-size:34px; }
  #jcrms .ov-sub { font-size:18px; }
  #jcrms .ov-grid {
    grid-template-columns:1fr;
    gap:32px;
  }
  #jcrms .ov-grid::before { display:none; }
  #jcrms .ov-card {
    flex-direction:row; text-align:left; gap:18px; align-items:flex-start;
  }
