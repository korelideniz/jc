  renderOverview();
  var html="";
  STEPS.forEach(function(s,i){ html+=stepHTML(s,i); });
  out.innerHTML=html;

  /* IntersectionObserver — overview + content 모두 */
  if("IntersectionObserver" in window){
    var obs=new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if(e.isIntersecting){e.target.style.animationPlayState="running";obs.unobserve(e.target);}
      });
    },{threshold:0.02,rootMargin:"0px 0px -10px 0px"});
    document.querySelectorAll("#jcrms .fu").forEach(function(el){obs.observe(el);});
  }
}

/* STEP 탭 이동 */
window.jcrmsGo=function(n){
  var el=document.getElementById("step-"+n); if(!el)return;
  var nav=document.getElementById("jcrms-nav");
  var off=(nav?nav.offsetHeight:60)+8;
  window.scrollTo({top:el.getBoundingClientRect().top+window.pageYOffset-off,behavior:"smooth"});
  document.querySelectorAll("#jcrms-nav .snav-btn").forEach(function(b){
    b.classList.toggle("active", b.getAttribute("data-s")==String(n));
  });
};

/* 스크롤 active 탭 */
(function(){
  var tick=false;
  window.addEventListener("scroll",function(){
    if(tick)return;tick=true;
    requestAnimationFrame(function(){
      var nav=document.getElementById("jcrms-nav");
      var navH=nav?nav.offsetHeight:60;
      var cur=null;
      document.querySelectorAll("[data-step]").forEach(function(s){
        if(s.getBoundingClientRect().top<=navH+80)cur=s.getAttribute("data-step");
      });
      if(cur){
        document.querySelectorAll("#jcrms-nav .snav-btn").forEach(function(b){
          b.classList.toggle("active",b.getAttribute("data-s")===cur);
        });
      }
      tick=false;
    });
  });
})();

if(document.readyState==="loading"){document.addEventListener("DOMContentLoaded",render);}
else{render();}
})();
</script>
