var delay=0;
function nd(){var d=delay;delay+=0.03;return d;}

function courseHTML(c, track){
  var fin=c.fin||0, on=c.on||0;
  var state=fin?"fin":(on?"on":"off");
  var cls="course-item"+(c.url?" lnk":"");
  var oc=c.url?" onclick=\"window.open('"+c.url+"','_blank')\"":"";
  var dotIcon=fin?"🎉":(on?"✓":"");
  var badge=fin?"🎉 시리즈 완결":(on?"✅ 공개 완료":"📅 공개 예정 · "+c.date);
  var d=nd();
  return "<div class='"+cls+" fu' "+oc+" style='animation-delay:"+d.toFixed(2)+"s;animation-play-state:paused;'>"
    +"<div class='course-dot "+state+"'>"+dotIcon+"</div>"
    +"<div class='course-info'>"
      +"<div class='course-name "+state+(fin?" fin":"")+"'>"+c.name+"</div>"
      +"<div class='course-sub "+state+(fin?" fin":"")+"'>"+c.sub+"</div>"
      +"<div class='course-status "+state+"'>"+badge+"</div>"
    +"</div>"
    +"</div>";
}

function stepHTML(s, idx){
  delay=0.1;
  var html="<div class='step-section' id='step-"+s.id+"' data-step='"+s.id+"'>";

  /* STEP 헤더 */
  html+="<div class='step-hd fu' style='animation-delay:0.05s;animation-play-state:paused;'>"
    +"<div class='step-num-col'>"
      +"<span class='step-step'>STEP</span>"
      +"<span class='step-n'>0"+s.id+"</span>"
      +"<span class='step-period'>"+s.period+"</span>"
    +"</div>"
    +"<div class='step-info-col'>"
      +"<div class='step-target-tag'>이런 분께 추천합니다</div>"
      +"<div class='step-title'>"+s.title+"</div>"
      +"<div class='step-target'>"+s.target.replace(/\n/g,"<br>")+"</div>"
    +"</div>"
  +"</div>";

  /* 트랙 */
  html+="<div class='step-body'>";

  /* 전공 */
  html+="<div class='track track-u'>"
    +"<div class='track-label u'><div class='track-dot'></div><span class='track-name'>📘 전공 과정</span></div>"
    +"<div class='course-list'>";
  s.upper.forEach(function(c){ html+=courseHTML(c,"u"); });
  html+="</div></div>";

  /* 평생 */
  html+="<div class='track track-l'>"
    +"<div class='track-label l'><div class='track-dot'></div><span class='track-name'>📖 평생 과정</span></div>"
    +"<div class='course-list'>";
  s.lower.forEach(function(c){ html+=courseHTML(c,"l"); });
  html+="</div></div>";

  html+="</div>"; /* step-body */

  if(idx < STEPS.length-1){
    html+="<div class='step-divider'></div>"
      +"<div class='step-arrow'>↓</div>";
  }

  html+="</div>"; /* step-section */
  return html;
}

