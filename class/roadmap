  #jcrms .ov-card-body { flex:1; display:flex; flex-direction:column; text-align:left; }
  #jcrms .ov-card-title { font-size:24px; }
  #jcrms .ov-target { font-size:18px; color:#444; font-weight:600; }
  #jcrms .ov-step-lbl { font-size:15px; }
  #jcrms .ov-tags { justify-content:flex-start; }
  #jcrms .ov-tag-item { font-size:16px; padding:7px 14px; }
}

/* ════ 모바일 ════ */
@media(max-width:767px){
  #jcrms .hd { padding:110px 20px 100px; }
  #jcrms .hd-title { font-size:46px; letter-spacing:-1px; }
  #jcrms .hd-sub { font-size:22px; }
  #jcrms .hd-desc { font-size:19px; }
  #jcrms .hd-badge { font-size:18px; padding:12px 20px; }
  #jcrms .step-nav { padding:0 12px; }
  #jcrms .snav-btn { padding:14px 16px; }
  #jcrms .snav-label { font-size:16px; }
  #jcrms .snav-num { font-size:12px; }
  #jcrms .step-hd { flex-direction:column; }
  #jcrms .step-num-col { width:100%; flex-direction:row; padding:24px 20px; gap:16px; justify-content:flex-start; }
  #jcrms .step-num-col::after { display:none; }
  #jcrms .step-n { font-size:60px; }
  #jcrms .step-info-col { padding:26px 20px; }
  #jcrms .step-title { font-size:28px; }
  #jcrms .step-target { font-size:20px; }
  #jcrms .step-target-tag { font-size:14px; }
  #jcrms .step-body { grid-template-columns:1fr; padding:24px 20px 0; gap:32px; }
  #jcrms .track { padding:0; border-right:none; border-bottom:2px solid #E8E2D8; padding-bottom:32px; }
  #jcrms .track:last-child { border-bottom:none; padding-bottom:0; }
  #jcrms .track-name { font-size:22px; }
  #jcrms .course-name { font-size:23px; }
  #jcrms .course-sub { font-size:18px; }
  #jcrms .course-status { font-size:16px; padding:7px 16px; }
  #jcrms .step-divider { margin:32px 20px 0; }
}
</style>

<div id="jcrms-outer">
<div id="jcrms">

