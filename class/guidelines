<script>
(function(){
  // Scroll reveal
  var cards = document.querySelectorAll('.fm-card');
  if ('IntersectionObserver' in window) {
    var obs = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if(e.isIntersecting) e.target.classList.add('fm-visible');
      });
    }, { threshold: 0.1 });
    cards.forEach(function(c){ obs.observe(c); });
  } else {
    cards.forEach(function(c){ c.classList.add('fm-visible'); });
  }

  // Smooth scroll nav
  document.querySelectorAll('.fm-nav a').forEach(function(a){
    a.addEventListener('click', function(e){
      var href = a.getAttribute('href');
      if(href && href.startsWith('#')){
        var el = document.querySelector(href);
        if(el){ e.preventDefault(); el.scrollIntoView({ behavior:'smooth', block:'center' }); }
      }
    });
  });
})();
</script>
