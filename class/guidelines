  --c-trvl:  #00B894; --c-trvl-lt:  #E6FAF7; --c-trvl-dk:  #007A63;
  --c-biz:   #6C3FC5; --c-biz-lt:   #F2EDFF; --c-biz-dk:   #4A2A8A;
  --c-faith: #C8860A; --c-faith-lt: #FDF8E6; --c-faith-dk: #8A5C00;
  --c-read:  #E0334C; --c-read-lt:  #FFF0F2; --c-read-dk:  #A01030;
  /* ── 워드프레스 컨테이너 강제 풀와이드 ── */
  width: 100vw;
  position: relative;
  left: 50%;
  right: 50%;
  margin-left: -50vw;
  margin-right: -50vw;
  overflow-x: hidden;
  background: #F8F7F4;
}

/* ── HEADER ── */
.fm-header {
  text-align: center;
  padding: 160px 24px 64px;
  background: linear-gradient(135deg, #1A1A2E 0%, #16213E 55%, #0F3460 100%);
  position: relative; overflow: hidden;
}
.fm-header::before, .fm-header::after {
  content: ''; position: absolute; border-radius: 50%;
}
.fm-header::before {
  width: 640px; height: 640px;
  background: radial-gradient(circle, rgba(255,255,255,0.05) 0%, transparent 70%);
  top: -220px; left: -120px;
  animation: fm-pulse 8s ease-in-out infinite;
}
.fm-header::after {
  width: 440px; height: 440px;
  background: radial-gradient(circle, rgba(255,200,80,0.07) 0%, transparent 70%);
  bottom: -110px; right: -60px;
  animation: fm-pulse 6s ease-in-out infinite reverse;
}
@keyframes fm-pulse {
  0%,100% { transform: scale(1); opacity: .5; }
  50%      { transform: scale(1.2); opacity: 1; }
}
.fm-header h1 {
  font-size: clamp(40px, 7vw, 88px);
  font-weight: 900; color: #fff;
  line-height: 1.2; margin-bottom: 18px;
  position: relative; z-index: 1;
}
.fm-header h1 span { color: #FFD166; }
.fm-header p {
  font-size: clamp(20px, 3vw, 38px);
  color: rgba(255,255,255,.75);
  font-weight: 500; position: relative; z-index: 1;
}

/* ── NAV ── */
.fm-nav {
  display: flex; flex-wrap: wrap; gap: 10px; justify-content: center;
  padding: 24px 20px; background: #1A1A2E;
  position: sticky; top: 0; z-index: 200;
  box-shadow: 0 4px 24px rgba(0,0,0,.35);
}
.fm-nav a {
  padding: 10px 22px; border-radius: 50px;
  font-size: clamp(15px, 2vw, 22px); font-weight: 800;
  color: #fff; text-decoration: none;
  transition: transform .22s, box-shadow .22s;
  display: inline-block;
}
.fm-nav a:hover { transform: translateY(-3px) scale(1.06); box-shadow: 0 8px 20px rgba(0,0,0,.3); }
.fm-nav .n-begin { background: var(--c-begin); }
.fm-nav .n-gram  { background: var(--c-gram); }
.fm-nav .n-trvl  { background: var(--c-trvl); }
.fm-nav .n-biz   { background: var(--c-biz); }
.fm-nav .n-faith { background: var(--c-faith); }
.fm-nav .n-read  { background: var(--c-read); }

/* ── CARDS WRAP ── */
.fm-cards {
  max-width: 1120px; margin: 0 auto;
  padding: 64px 20px 100px;
  display: flex; flex-direction: column; gap: 80px;
}

/* ── CARD ── */
.fm-card {
  border-radius: 28px; overflow: hidden;
  box-shadow: 0 16px 60px rgba(0,0,0,.13);
  opacity: 0; transform: translateY(64px);
  transition: opacity .75s ease, transform .75s ease;
}
.fm-card.fm-visible { opacity: 1; transform: translateY(0); }

.fm-card-inner {
  display: grid; grid-template-columns: 1fr 1fr; min-height: 440px;
}
.fm-card:nth-child(even) .fm-card-inner { direction: rtl; }
.fm-card:nth-child(even) .fm-card-inner > * { direction: ltr; }

/* IMAGE */
.fm-img { position: relative; overflow: hidden; min-height: 320px; }
.fm-img img {
  width: 100%; height: 100%; object-fit: cover;
  transition: transform .6s ease; display: block;
}
.fm-card:hover .fm-img img { transform: scale(1.06); }
.fm-img-ov {
  position: absolute; inset: 0;
  background: linear-gradient(to bottom, rgba(0,0,0,.05), rgba(0,0,0,.35));
}

/* CONTENT */
.fm-content {
  padding: 50px 44px;
  display: flex; flex-direction: column;
  justify-content: center; gap: 20px;
  position: relative; overflow: hidden;
}
.fm-content::before {
  content: ''; position: absolute;
  width: 320px; height: 320px; border-radius: 50%;
  opacity: .07; bottom: -90px; right: -90px;
  background: currentColor;
}

/* BADGE */
.fm-badge {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 10px 26px; border-radius: 50px;
  font-size: clamp(20px, 2.5vw, 32px); font-weight: 900;
  color: #fff; width: fit-content;
}

/* TITLE */
.fm-title {
  font-size: clamp(28px, 3.8vw, 52px);
  font-weight: 900; line-height: 1.3;
}

/* QUOTE */
.fm-quote {
  font-size: clamp(17px, 2vw, 27px); font-weight: 600;
  line-height: 1.7; padding: 16px 20px;
  border-radius: 12px; border-left: 6px solid;
  font-style: italic; color: #333;
}

/* DESC */
.fm-desc {
  font-size: clamp(17px, 1.9vw, 26px);
  line-height: 1.75; color: #444; font-weight: 500;
}

/* CURRICULUM */
.fm-cur { margin-top: 4px; }
.fm-cur-label {
  font-size: clamp(14px, 1.6vw, 20px); font-weight: 700;
  color: #999; text-transform: uppercase; letter-spacing: 1.5px;
  margin-bottom: 12px;
}
.fm-steps {
  display: flex; flex-wrap: wrap;
  align-items: center; gap: 8px;
}

/* ── STEP BUTTON with pulse ── */
.fm-step {
  display: inline-block;
  padding: 12px 20px; border-radius: 10px;
  font-size: clamp(14px, 1.6vw, 20px); font-weight: 800;
  color: #fff; text-decoration: none;
  cursor: pointer;
  position: relative;
  animation: fm-step-pulse 2.2s ease-in-out infinite;
  transition: transform .18s, box-shadow .18s;
  box-shadow: 0 0 0 0 rgba(0,0,0,0);
}
.fm-step:hover {
  transform: scale(1.12) translateY(-2px) !important;
  animation-play-state: paused;
  text-decoration: none; color: #fff;
}

/* stagger delays so they don't all pulse together */
.fm-steps .fm-step:nth-child(1) { animation-delay: 0s; }
.fm-steps .fm-step:nth-child(3) { animation-delay: 0.35s; }
.fm-steps .fm-step:nth-child(5) { animation-delay: 0.7s; }
.fm-steps .fm-step:nth-child(7) { animation-delay: 1.05s; }

@keyframes fm-step-pulse {
  0%   { transform: scale(1); }
  40%  { transform: scale(1.07); }
  55%  { transform: scale(0.97); }
  70%  { transform: scale(1.04); }
  100% { transform: scale(1); }
}

.fm-arrow {
  font-size: clamp(18px, 2vw, 26px); color: #bbb; font-weight: 900;
}

/* ── PER-THEME colours ── */
/* BEGINNER */
.fm-card.c-begin .fm-content { background: var(--c-begin-lt); }
