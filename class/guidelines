.fm-card.c-faith .fm-step    { background: var(--c-faith); color: #fff; }
/* READING */
.fm-card.c-read .fm-content { background: var(--c-read-lt); }
.fm-card.c-read .fm-badge   { background: var(--c-read); }
.fm-card.c-read .fm-title   { color: var(--c-read-dk); }
